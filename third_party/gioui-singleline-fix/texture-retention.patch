 			delete(r.res, k)
 			v.resource.release()
+		default:
+			b := resourceBytes(v.resource)
+			idleBytes += b
+			idles = append(idles, idle{k, v.lastUsed, b})
 		}
 	}
+	if idleBytes <= textureKeepBytes {
+		return
+	}
+	sort.Slice(idles, func(i, j int) bool { return idles[i].lastUsed < idles[j].lastUsed })
+	for _, it := range idles {
+		if idleBytes <= textureKeepBytes {
+			break
+		}
+		v := r.res[it.key]
+		delete(r.res, it.key)
+		v.resource.release()
+		idleBytes -= it.bytes
+	}
