+
+// resourceBytes estimates a cached resource's pixel memory.
+func resourceBytes(res resource) int {
+	if t, ok := res.(*texture); ok && t.src != nil {
+		return 4 * t.src.Bounds().Dx() * t.src.Bounds().Dy()
+	}
+	return 0
